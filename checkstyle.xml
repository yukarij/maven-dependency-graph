<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="FileLength"><property name="max" value="1000"/></module>
    <module name="LineLength"><property name="max" value="120"/></module>
    <module name="FileTabCharacter"/>
    <module name="TreeWalker">
        <module name="MethodLength">
            <property name="max" value="40"/>
            <property name="countEmpty" value="true"/>
        </module>
        <module name="ParameterNumber"><property name="max" value="7"/></module>
        <module name="CyclomaticComplexity"><property name="max" value="10"/></module>
        <module name="MagicNumber"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>
        <module name="PackageName"/>
        <module name="AvoidStarImport"/>
        <module name="MissingJavadocMethod"><property name="scope" value="private"/></module>
        <module name="MissingJavadocType"><property name="scope" value="private"/></module>
    </module>
</module>
